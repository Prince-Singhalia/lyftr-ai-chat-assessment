LLM_API_KEYS=replace_with_two_keys
LLM_MODEL=gemini/gemini-3.1-flash-lite
LLM_API_BASE=
GROQ_API_KEY=replace_with_groq_api_key
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_MODEL=groq/openai/gpt-oss-20b
# Docker Compose uses its named app_data volume. For native local runs use
# sqlite:///./data/app.db instead. Production uses the Neon PostgreSQL URL below.
DATABASE_URL=sqlite:////data/app.db
# Neon format (copy the generated value from Neon; never commit real credentials):
# postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=false
LITELLM_CACHE=true
CACHE_DIR=/data/cache
ENVIRONMENT=development
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000

